# Copy to apps/web/.env. Never commit the filled-in file.

# Local Postgres from docker compose, or Neon. `neon env pull --file .env.local` writes
# both Neon URLs: the pooled DATABASE_URL for the app and DATABASE_URL_UNPOOLED, which
# the migration and setup scripts use.
DATABASE_URL=postgres://niche:niche@localhost:5432/nicheparts
DATABASE_URL_UNPOOLED=

# Admin sign-in uses Clerk. Copy both keys from the Clerk dashboard (API keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/login

# Comma-separated. Only these Clerk accounts (verified email) can open the dashboard.
ADMIN_EMAILS=admin@example.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe secret key. Use a test key until you are ready to take live payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Order emails are skipped until both are set.
RESEND_API_KEY=
ORDERS_FROM_EMAIL=

# Optional. Mail sent to any address at the domain is forwarded here (comma-separated).
# Needs receiving enabled on the domain in Resend, a full access RESEND_API_KEY, and an
# email.received webhook pointing at /api/webhooks/resend with its signing secret below.
CONTACT_FORWARD_TO=
RESEND_WEBHOOK_SECRET=

# Optional. Lets the admin copy eBay listings. Use the App ID and Cert ID of a
# production keyset from developer.ebay.com. Shopify links work without these.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional. Sends each paid order to Khayt so it becomes a print job. In Khayt, open
# Settings, Integrations, Medusa: the import link ends in /import/medusa. Create an import
# key there too; without it Khayt files orders as requests to review instead of paid jobs.
KHAYT_IMPORT_URL=
KHAYT_IMPORT_KEY=

# Neon Object Storage (any S3-compatible storage works) for product images and
# print files. Both buckets are private: /api/media serves STORAGE_BUCKET through
# this site so the CDN can cache it, and print files use short-lived signed links.
# Get the endpoint with `neon api /projects/<id>/branches/<branch>/storage` and the
# keys with `neon credentials create --scope storage:read --scope storage:write`.
# When set, this takes priority over Supabase.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=product-images
STORAGE_PRINT_FILES_BUCKET=print-files
STORAGE_PUBLIC_URL=/api/media

# Optional. Without object storage or these, images are stored in apps/web/storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used by the collection sync. This does not change the live Shopify store.
SHOPIFY_STORE_URL=https://nicheparts.com.au
