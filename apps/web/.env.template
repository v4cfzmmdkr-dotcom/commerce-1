# Copy to apps/web/.env. Never commit the filled-in file.

# Local Postgres from docker compose, or a Supabase pooler URL.
# On Vercel use the Transaction pooler (aws-0-<region>.pooler.supabase.com:6543),
# not db.<project>.supabase.co — that host is IPv6-only and times out.
DATABASE_URL=postgres://niche:niche@localhost:5432/nicheparts

# openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe secret key. Use a test key until you are ready to take live payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Order emails are skipped until both are set.
RESEND_API_KEY=
ORDERS_FROM_EMAIL=

# Optional. Without these, images are stored in apps/web/storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used by the collection sync. This does not change the live Shopify store.
SHOPIFY_STORE_URL=https://nicheparts.com.au
